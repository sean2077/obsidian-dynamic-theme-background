{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2021",
        "strict": true,
        "allowJs": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "isolatedModules": true,
        "lib": ["DOM", "ES2021"],
        // other options
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "include": [
        "**/*.ts"
    ]
}
