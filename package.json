{
    "name": "obsidian-dynamic-theme-background-plugin",
    "version": "2.9.0",
    "description": "A plugin for Obsidian that dynamically changes the background based on time of day and user settings.",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "check": "npm run build && npm run lint && npm run lint:css && npm test",
        "evaluate": "node tools/quality/evaluate.mjs",
        "fmt": "prettier --write src/**/*.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:css": "stylelint \"styles.css\"",
        "fix:css": "stylelint \"styles.css\" --fix",
        "test": "node tools/quality/test.mjs"
    },
    "keywords": [],
    "author": "sean2077",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^24.10.1",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.4.1",
        "globals": "^17.6.0",
        "jiti": "^2.6.1",
        "obsidian": "^1.10.3",
        "prettier": "^3.7.3",
        "stylelint": "^16.26.1",
        "stylelint-config-idiomatic-order": "^10.0.0",
        "stylelint-config-recommended": "^17.0.0",
        "stylelint-config-standard": "^39.0.1",
        "stylelint-order": "^7.0.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.1"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
